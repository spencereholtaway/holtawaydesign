---
import Base from '../layouts/Base.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import PrivacyScript from '../components/PrivacyScript.astro';
import Shot from '../components/Shot.astro';
import css from '../styles/olivers-train.css?raw';
---

<Base
  title={"Oliver's Train — a game you can't win, lose, or cheat"}
  description={"An ambient train ride for iPhone. Listen to the rails, spot cows, cottages and churches out the window, and log Mindful Minutes to Apple Health."}
  path="/olivers-train"
  fonts="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Doto:wght@500..900&display=swap"
  css={css}
  og="olivers-train/01"
  themeColor="#1F4D3A"
>
  <div style="font-family:'Archivo',system-ui,sans-serif; font-size:18px; line-height:1.55; min-height:100vh; overflow-x:clip">
    <header style="background:#1F4D3A; color:#EFE7D2; border-bottom:6px solid #C8372D">
      <div style="max-width:1240px; margin:0 auto; padding:16px clamp(20px,4vw,48px); display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; row-gap:8px">
        <span style="font-weight:800; font-stretch:125%; font-size:20px; letter-spacing:0.02em; text-transform:uppercase">Oliver's Train</span>
        <nav style="display:flex; gap:20px; font-size:15px; font-weight:600"><a href="#support" style="color:#EFE7D2; text-decoration:none">Support</a><a href="#privacy" style="color:#EFE7D2; text-decoration:none">Privacy</a></nav>
      </div>
    </header>

    <section data-screen-label="Hero" style="max-width:1240px; margin:0 auto; padding:clamp(48px,8vw,112px) clamp(20px,4vw,48px) clamp(48px,6vw,80px); display:grid; gap:28px">
      <span style="font-weight:700; font-size:14px; letter-spacing:0.14em; text-transform:uppercase; color:#C8372D">Platform 1 · Now boarding</span>
      <h1 style="margin:0; font-weight:900; font-stretch:115%; font-size:clamp(52px,8.4vw,124px); line-height:0.9; letter-spacing:-0.03em; max-width:13ch; text-wrap:balance; color:#1F4D3A">A game you can't win, lose, or cheat.</h1>
      <div style="display:flex; flex-wrap:wrap; gap:24px 48px; align-items:end; justify-content:space-between">
        <p style="margin:0; max-width:38ch; font-size:clamp(18px,1.7vw,22px); text-wrap:pretty">An ambient train ride for iPhone. Turn it sideways, listen to the rails, and tap when you spot what the conductor asks for.</p>
        <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center">
          <AppStoreButton app="olivers-train" />
        
        </div>
      </div>
    </section>

    <section data-screen-label="Window" style="max-width:1240px; margin:0 auto; padding:0 clamp(20px,4vw,48px) clamp(80px,10vw,140px)">
      <div style="background:#1F4D3A; padding:clamp(14px,2vw,28px); border-radius:clamp(20px,3vw,44px); box-shadow:inset 0 0 0 4px #163829, 0 30px 60px -28px rgba(27,43,34,0.5)">
        <div style="position:relative; aspect-ratio:3078/1926; border-radius:clamp(12px,2vw,28px); overflow:hidden; background:#CFE0D0"><Shot name="olivers-train/01" alt="Oliver's Train — the view from the window" widths={[640, 960, 1280, 1700, 2200]} sizes="(max-width: 1239px) calc(100vw - 80px), 1100px" eager style="position:absolute; inset:0; display:block; width:100%; height:100%; object-fit:cover" /></div>
      </div>
    </section>

    <section data-screen-label="Departures" style="max-width:1240px; margin:0 auto; padding:0 clamp(20px,4vw,48px) clamp(80px,10vw,140px); display:grid; gap:28px">
      <h2 style="margin:0; font-weight:900; font-stretch:115%; font-size:clamp(36px,5vw,64px); line-height:0.95; letter-spacing:-0.02em; color:#1F4D3A">On this service</h2>
      <div style="background:#111410; color:#FFB547; border-radius:10px; padding:clamp(16px,3vw,32px); font-family:'Doto',monospace; font-weight:800; display:grid; gap:2px; box-shadow:inset 0 0 0 3px #2A2E28">
        <div style="display:grid; grid-template-columns:minmax(0,14ch) minmax(0,1fr); gap:8px 24px; padding:14px 0; border-bottom:1px solid #2A2E28; font-size:clamp(18px,2vw,24px); text-transform:uppercase; letter-spacing:0.04em"><span>The ride</span><span style="font-family:'Archivo',sans-serif; font-weight:500; text-transform:none; letter-spacing:0; font-size:17px; color:#F3DDB4">Train sounds of the kind people fall asleep to, or put on to block out a noisy room.</span></div>
        <div style="display:grid; grid-template-columns:minmax(0,14ch) minmax(0,1fr); gap:8px 24px; padding:14px 0; border-bottom:1px solid #2A2E28; font-size:clamp(18px,2vw,24px); text-transform:uppercase; letter-spacing:0.04em"><span>I spy</span><span style="font-family:'Archivo',sans-serif; font-weight:500; text-transform:none; letter-spacing:0; font-size:17px; color:#F3DDB4">Each round names something in the scenery, cows or cottages or churches, and you tap when you see one.</span></div>
        <div style="display:grid; grid-template-columns:minmax(0,14ch) minmax(0,1fr); gap:8px 24px; padding:14px 0; border-bottom:1px solid #2A2E28; font-size:clamp(18px,2vw,24px); text-transform:uppercase; letter-spacing:0.04em"><span>Announcements</span><span style="font-family:'Archivo',sans-serif; font-weight:500; text-transform:none; letter-spacing:0; font-size:17px; color:#F3DDB4">Spoken station and train announcements as you go.</span></div>
        <div style="display:grid; grid-template-columns:minmax(0,14ch) minmax(0,1fr); gap:8px 24px; padding:14px 0; border-bottom:1px solid #2A2E28; font-size:clamp(18px,2vw,24px); text-transform:uppercase; letter-spacing:0.04em"><span>Look around</span><span style="font-family:'Archivo',sans-serif; font-weight:500; text-transform:none; letter-spacing:0; font-size:17px; color:#F3DDB4">Turn on head or tilt movement and the view out the window moves gently with you.</span></div>
        <div style="display:grid; grid-template-columns:minmax(0,14ch) minmax(0,1fr); gap:8px 24px; padding:14px 0; border-bottom:1px solid #2A2E28; font-size:clamp(18px,2vw,24px); text-transform:uppercase; letter-spacing:0.04em"><span>Mindful minutes</span><span style="font-family:'Archivo',sans-serif; font-weight:500; text-transform:none; letter-spacing:0; font-size:17px; color:#F3DDB4">Connect Apple Health and each journey is saved as Mindful Minutes.</span></div>
        <div style="display:grid; grid-template-columns:minmax(0,14ch) minmax(0,1fr); gap:8px 24px; padding:14px 0; font-size:clamp(18px,2vw,24px); text-transform:uppercase; letter-spacing:0.04em"><span>Next departure<span style="animation:otBlink 1.2s steps(1) infinite">_</span></span><span style="font-family:'Archivo',sans-serif; font-weight:500; text-transform:none; letter-spacing:0; font-size:17px; color:#F3DDB4">Home Screen widgets show upcoming departures, and Game Center keeps your achievements.</span></div>
      </div>
    </section>

    <section id="support" data-screen-label="Support" style="background:#1F4D3A; color:#EFE7D2; border-top:6px solid #C8372D">
      <div style="max-width:1240px; margin:0 auto; padding:clamp(48px,7vw,96px) clamp(20px,4vw,48px); display:flex; flex-wrap:wrap; justify-content:space-between; align-items:end; gap:24px">
        <h2 style="margin:0; font-weight:900; font-stretch:115%; font-size:clamp(36px,4.5vw,56px); line-height:0.95; letter-spacing:-0.02em">need help? e-mail me!</h2>
        <a href="mailto:trainride@holtawaydesign.com" style="color:#FFB547; font-size:clamp(18px,2vw,24px); font-weight:600">trainride@holtawaydesign.com</a>
      </div>
    </section>

    <section id="privacy" data-screen-label="Privacy Policy" style="max-width:1240px; margin:0 auto; padding:clamp(48px,7vw,96px) clamp(20px,4vw,48px) clamp(80px,10vw,140px); display:block">
      <details style="border-top:1px solid #1F4D3A; border-bottom:1px solid #1F4D3A">
        <summary style="cursor:pointer; list-style:none; display:flex; justify-content:space-between; align-items:center; gap:16px; min-height:64px; font-weight:600; font-size:17px; color:#1F4D3A">View privacy policy<span aria-hidden="true" style="font-size:24px; font-weight:400">+</span></summary>
        <div style="padding:8px 0 48px; max-width:70ch; display:grid; gap:14px; font-size:17px; color:#2E3D33">
        <h2 style="margin:0; font-weight:900; font-stretch:110%; font-size:clamp(30px,3.6vw,44px); line-height:1; letter-spacing:-0.02em; color:#1F4D3A">Privacy Policy — Oliver's Train</h2>
        <p style="margin:0"><strong>Last updated: 4 October 2026</strong></p>
        <p style="margin:0">Oliver's Train is made by Holtaway Design ("we", "us"). This policy explains what information the app uses and why. The short version: <strong>we don't collect, store, or sell any of your personal data.</strong></p>
        <h3 style="margin:24px 0 0; font-weight:800; font-size:21px; color:#1F4D3A">What we collect</h3>
        <p style="margin:0">Nothing. Oliver's Train has no accounts, no analytics, no advertising and no tracking. It doesn't send any information to us or to third parties.</p>
        <h3 style="margin:24px 0 0; font-weight:800; font-size:21px; color:#1F4D3A">Information that stays on your device</h3>
        <ul style="margin:0; padding-left:1.2em; display:grid; gap:8px">
          <li><strong>Settings and progress.</strong> Your preferences, journeys and achievement progress are saved on your device so the app remembers them. We never see them.</li>
          <li><strong>Motion sensors.</strong> If you turn on head or tilt movement, the app reads your device's motion sensors to gently move the view. This happens in real time on your device. Nothing is recorded or shared.</li>
          <li><strong>Widgets.</strong> Home Screen widgets show information from the app, such as upcoming departures. This information stays on your device.</li>
        </ul>
        <h3 style="margin:24px 0 0; font-weight:800; font-size:21px; color:#1F4D3A">Apple Health</h3>
        <p style="margin:0">If you choose to connect Apple Health, Oliver's Train saves your journeys to Health as <strong>Mindful Minutes</strong>. The app <strong>does not read</strong> any of your Health data. Health access is entirely optional, and you can turn it off at any time in the Settings app under Health › Data Access &amp; Devices.</p>
        <p style="margin:0">Health data is never used for advertising or marketing, and it is never shared with third parties.</p>
        <h3 style="margin:24px 0 0; font-weight:800; font-size:21px; color:#1F4D3A">Game Center</h3>
        <p style="margin:0">If you're signed in to Game Center, the app reports your achievements to Apple's Game Center service. Apple handles this under its own privacy policy: <a href="https://www.apple.com/legal/privacy/">https://www.apple.com/legal/privacy/</a>. We don't receive your Game Center information.</p>
        <h3 style="margin:24px 0 0; font-weight:800; font-size:21px; color:#1F4D3A">Sharing</h3>
        <p style="margin:0">If you share an achievement, the app opens Apple's standard share sheet. You choose what to share and where. Nothing is sent unless you send it.</p>
        <h3 style="margin:24px 0 0; font-weight:800; font-size:21px; color:#1F4D3A">Children</h3>
        <p style="margin:0">Oliver's Train doesn't knowingly collect personal information from anyone, including children under 13.</p>
        <h3 style="margin:24px 0 0; font-weight:800; font-size:21px; color:#1F4D3A">Changes to this policy</h3>
        <p style="margin:0">If this policy changes, we'll update it here and change the date at the top.</p>
        <h3 style="margin:24px 0 0; font-weight:800; font-size:21px; color:#1F4D3A">Contact</h3>
        <p style="margin:0">Questions about privacy? Email <strong><a href="mailto:trainride@holtawaydesign.com">trainride@holtawaydesign.com</a></strong>.</p>
      </div>
      </details>
    </section>

    <footer style="max-width:1240px; margin:0 auto; padding:24px clamp(20px,4vw,48px) 40px; border-top:2px solid #1F4D3A; display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; font-size:14px; color:#4E5D52">
      <span>Oliver's Train</span>
      <span>Made by <a href="/">Spencer Holtaway</a></span>
    </footer>
  </div>
  <PrivacyScript />
</Base>
