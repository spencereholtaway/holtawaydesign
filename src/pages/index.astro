---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import RecentWork from '../components/RecentWork.astro';
import tokens from '../styles/tokens.css?raw';
import system from '../styles/system.css?raw';
import recent from '../styles/recent.css?raw';
import css from '../styles/index.css?raw';

const EMAIL = 'spencer@holtawaydesign.com';

const jobs = [
  { co: 'ChipStack', title: 'Product & brand design', dates: '2025 – 2026' },
  { co: 'Red9', title: 'Product & brand design', dates: '2023 – 2024' },
  { co: 'Calm', title: 'Staff Product Designer', dates: '2020 – 2024' },
  { co: 'Dialpad', title: 'Head of Design', dates: '2016 – 2020' },
  { co: 'Shuddle', title: 'Senior UX Designer', dates: '2014 – 2016' },
  { co: 'Zynga', title: 'Lead UI Designer', dates: '2010 – 2014' },
  { co: 'Small London agencies', title: 'Experiential, spatial and print design', dates: '2006 – 2010' },
  { co: 'Central Saint Martins', title: 'BA Visual Communication', dates: '2003 – 2006' },
];

const sections = [
  { id: 'work', label: 'Recent work' },
  { id: 'about', label: 'About' },
  { id: 'ethics', label: 'Ethics' },
  { id: 'history', label: 'History' },
];
---

<Base
  title="Spencer Holtaway"
  description="Spencer Holtaway, Staff Product Designer."
  path="/"
  fonts="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
  css={tokens + system + recent + css}
  ogFile="/og/home.png?v=2"
  themeColor="#FAFAF7"
>
  <div class="page page--home">
    <SiteNav
      email={EMAIL}
      sections={sections}
      nav={sections.map((s) => ({ href: `#${s.id}`, label: s.label, section: s.id }))}
    />

    <main id="top" class="container home-main">
      <h1 class="home-title"><span>Spencer Holtaway<span class="t-accent">,</span></span><span>Staff Product Designer</span></h1>

      <RecentWork id="work" />

      <div class="home-pair">
        <section id="about" class="home-section">
          <span class="home-label">About</span>
          <p class="home-about-lede">Making things and hearing “thank you” at the end is what it’s all about for me.</p>
          <p class="t-body">I started out designing real-world experiences, then games at Zynga, then a long stretch in SaaS as Head of Design at Dialpad and Staff Product Designer at Calm.</p>
          <p class="t-body">Whether it's a phone system's admin settings, a carpool app for families or how someone feels when they open Calm, I take on the complexity so the person using it doesn't have to.</p>
          <p class="home-roleline"><span data-roleline><span>AI Native Staff Product Designer</span><span>San Rafael, CA</span></span></p>
        </section>

        <section id="ethics" class="home-section">
          <span class="home-label">What I stand for</span>
          <ul class="home-list">
            <li>Meet customers where they are.</li>
            <li>Make it worth coming back to.</li>
            <li>No dark patterns.</li>
          </ul>
        </section>
      </div>

      <section id="history" class="home-section">
        <span class="home-label">Work history</span>
        <div class="home-jobs">
          {jobs.map((j) => (
            <div class="home-job">
              <span class="home-job__co">{j.co}</span>
              <span class="home-job__title">{j.title}</span>
              <span class="home-job__dates">{j.dates}</span>
            </div>
          ))}
        </div>
      </section>
    </main>

    <footer class="home-footer">
      <span>© 2026 Spencer Holtaway</span>
      <span class="home-footer__links"><a href={`mailto:${EMAIL}`}>{EMAIL}</a><a href="https://linkedin.com/in/holtawaydesign">LinkedIn</a></span>
    </footer>
  </div>

</Base>
