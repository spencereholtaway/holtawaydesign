---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import SiteNav from '../components/SiteNav.astro';
import { APPS } from '../data/apps';
import tokens from '../styles/tokens.css?raw';
import system from '../styles/system.css?raw';
import css from '../styles/index.css?raw';

const EMAIL = 'spencer@holtawaydesign.com';

const jobs = [
  { co: 'Chipstack', title: 'Product & brand design', dates: '2025 – 2026' },
  { co: 'Red9', title: 'Product & brand design', dates: '2023 – 2024' },
  { co: 'Calm', title: 'Staff Product Designer', dates: '2020 – 2024' },
  { co: 'Dialpad', title: 'Head of Design', dates: '2016 – 2020' },
  { co: 'Shuddle', title: 'Senior UX Designer', dates: '2014 – 2016' },
  { co: 'Zynga', title: 'Lead UI Designer', dates: '2010 – 2014' },
  { co: 'Small London agencies', title: 'Experiential, spatial and print design', dates: '2006 – 2010' },
  { co: 'Central Saint Martins', title: 'BA Visual Communication', dates: '2003 – 2006' },
];

const sections = [
  { id: 'work', label: 'Recent work' },
  { id: 'about', label: 'About' },
  { id: 'ethics', label: 'Ethics' },
  { id: 'history', label: 'History' },
];
---

<Base
  title="Spencer Holtaway"
  description="Spencer Holtaway, Staff Product Designer."
  path="/"
  fonts="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
  css={tokens + system + css}
  ogFile="/og/home.png?v=2"
  themeColor="#FAFAF7"
>
  <div class="page page--home">
    <SiteNav
      email={EMAIL}
      sections={sections}
      nav={sections.map((s) => ({ href: `#${s.id}`, label: s.label, section: s.id }))}
    />

    <main id="top" class="container home-main">
      <h1 class="home-title"><span>Spencer Holtaway<span class="t-accent">,</span></span><span>Staff Product Designer</span></h1>

      <section id="work" class="recent">
        <h2 class="recent__title">What I've been working on recently</h2>
        <p class="recent__lede">Five apps, designed and built end to end. With AI doing more of the building, I spend more of my time on the parts I care about: how it feels in your hand, what it does when you’re not looking, and whether it’s worth coming back to.</p>
        <div data-bento>
          <a href="/fishingforcompliments" data-tile="ffc">
            <div data-panel style="--tint:#3A2D4A">
              <Shot name="fishingforcompliments/isles" alt="Fishing for Compliments: Isles gameplay" widths={[480, 720, 960, 1280, 1600, 1920, 2400]} sizes="(max-width: 900px) 127vw, min(72vw, 980px)" style="object-position:50% 60%; transform:scale(1.03)" />
            </div>
            <div class="tile__text">
              <span class="tile__name">{APPS.fishingforcompliments.name}</span>
              <span class="tile__line">A game with no finish line →</span>
            </div>
          </a>
          <a href="/breathebody" data-tile="bb">
            <div data-panel style="--tint:#0B0B10">
              <Shot name="breathebody/01" alt="Breath Body screen" widths={[240, 360, 480, 640, 900]} sizes="(max-width: 560px) 50vw, (max-width: 900px) 34vw, 440px" style="object-position:50% 45%" />
            </div>
            <div class="tile__text">
              <span class="tile__name">{APPS.breathebody.name}</span>
              <span class="tile__line">Breathwork for less than a cup of coffee →</span>
            </div>
          </a>
          <a href="/mybussf" data-tile="mb">
            <div data-panel style="--tint:#FFB000">
              <Shot name="mybussf/saved-stops" alt="My Bus SF Home Screen widgets" widths={[240, 360, 480, 640, 900]} sizes="(max-width: 560px) 50vw, (max-width: 900px) 34vw, 330px" style="object-position:50% 0%" />
            </div>
            <div class="tile__text">
              <span class="tile__name">{APPS.mybussf.name}</span>
              <span class="tile__line">Real-time Muni arrivals →</span>
            </div>
          </a>
          <a href="/olivers-train" data-tile="ot">
            <div data-panel style="--tint:#1F4D3A">
              <Shot name="olivers-train/01" alt="Oliver’s Train window view" widths={[480, 720, 960, 1280, 1600, 1920]} sizes="(max-width: 900px) 100vw, 680px" style="object-position:50% 0%" />
            </div>
            <div class="tile__text">
              <span class="tile__name">{APPS['olivers-train'].name}</span>
              <span class="tile__line">A game you can’t win, lose, or cheat →</span>
            </div>
          </a>
          <a href="/pingpongcowboy" data-tile="pp">
            <div data-panel style="--tint:#4A2C19">
              <Shot name="pingpongcowboy/01" alt="Ping Pong Cowboy screen" widths={[240, 360, 480, 640, 900, 1200]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 34vw, 330px" style="object-position:50% 0%" />
            </div>
            <div class="tile__text">
              <span class="tile__name">{APPS.pingpongcowboy.name}</span>
              <span class="tile__line">Remember when phones were toys? →</span>
            </div>
          </a>
        </div>
      </section>

      <div class="home-pair">
        <section id="about" class="home-section">
          <span class="home-label">About</span>
          <p class="home-about-lede">Making things and hearing “thank you” at the end is what it’s all about for me.</p>
          <p class="t-body">I started out designing real-world experiences, then games at Zynga, then a long stretch in SaaS as Head of Design at Dialpad and Staff Product Designer at Calm.</p>
          <p class="t-body">Whether it's a phone system's admin settings, a carpool app for families or how someone feels when they open Calm, I take on the complexity so the person using it doesn't have to.</p>
          <p class="home-roleline"><span data-roleline><span>AI Native Staff Product Designer</span><span>San Rafael, CA</span></span></p>
        </section>

        <section id="ethics" class="home-section">
          <span class="home-label">What I stand for</span>
          <ul class="home-list">
            <li>Meet customers where they are.</li>
            <li>Make it worth coming back to.</li>
            <li>No dark patterns.</li>
          </ul>
        </section>
      </div>

      <section id="history" class="home-section">
        <span class="home-label">Work history</span>
        <div class="home-jobs">
          {jobs.map((j) => (
            <div class="home-job">
              <span class="home-job__co">{j.co}</span>
              <span class="home-job__title">{j.title}</span>
              <span class="home-job__dates">{j.dates}</span>
            </div>
          ))}
        </div>
      </section>
    </main>

    <footer class="home-footer">
      <span>© 2026 Spencer Holtaway</span>
      <span class="home-footer__links"><a href={`mailto:${EMAIL}`}>{EMAIL}</a><a href="https://linkedin.com/in/holtawaydesign">LinkedIn</a></span>
    </footer>
  </div>

  <script is:inline>
    // Bento tiles: the card tilts toward the cursor for mouse/trackpad users.
    (function () {
      if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelectorAll('[data-tile]').forEach(function (tile) {
        var panel = tile.querySelector('[data-panel]');
        var x = 0.5, y = 0.5, frame = 0;
        function apply() {
          frame = 0;
          panel.style.setProperty('--rx', ((0.5 - y) * 8).toFixed(2) + 'deg');
          panel.style.setProperty('--ry', ((x - 0.5) * 10).toFixed(2) + 'deg');
        }
        tile.addEventListener('pointerenter', function () { panel.setAttribute('data-tilting', ''); });
        tile.addEventListener('pointermove', function (e) {
          var r = panel.getBoundingClientRect();
          x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
          y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
          if (!frame) frame = requestAnimationFrame(apply);
        });
        tile.addEventListener('pointerleave', function () {
          panel.removeAttribute('data-tilting');
          x = 0.5; y = 0.5;
          if (!frame) frame = requestAnimationFrame(apply);
        });
      });
    })();
  </script>
</Base>
