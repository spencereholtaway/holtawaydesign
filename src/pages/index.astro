---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import css from '../styles/index.css?raw';

const jobs = [
  { co: 'Chipstack', title: 'Product & brand design', dates: '2025 – 2026' },
  { co: 'Red9', title: 'Product & brand design', dates: '2023 – 2024' },
  { co: 'Calm', title: 'Staff Product Designer', dates: '2020 – 2024' },
  { co: 'Dialpad', title: 'Head of Design', dates: '2016 – 2020' },
  { co: 'Shuddle', title: 'Senior UX Designer', dates: '2014 – 2016' },
  { co: 'Zynga', title: 'Lead UI Designer', dates: '2010 – 2014' },
  { co: 'Small London agencies', title: 'Experiential, spatial and print design', dates: '2006 – 2010' },
  { co: 'Central Saint Martins', title: 'BA Visual Communication', dates: '2003 – 2006' },
];
---

<Base
  title="Spencer Holtaway"
  description="Spencer Holtaway, Staff Product Designer."
  path="/"
  fonts="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
  css={css}
  ogFile="/og/home.png"
  themeColor="#FAFAF7"
>
  <div style="font-family:'Schibsted Grotesk',Helvetica,sans-serif; font-size:18px; line-height:1.5; min-height:100vh; display:grid; grid-template-rows:auto 1fr auto">
    <header style="position:sticky; top:0; z-index:10; background:rgba(250,250,247,0.92); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); border-bottom:1px solid #E4E2DC">
      <div style="max-width:1360px; margin:0 auto; padding:14px clamp(20px,4vw,56px); display:flex; justify-content:space-between; align-items:center; gap:16px; min-height:73px">
        <a href="#top" data-totop style="font-weight:700; font-size:16px; letter-spacing:-0.01em; display:flex; gap:8px; white-space:nowrap; min-height:44px; align-items:center"><span style="display:block; height:1.3em; line-height:1.3; overflow:hidden"><span data-roll style="display:flex; flex-direction:column; transition:transform 460ms cubic-bezier(.2,.7,.2,1); transform:none"><span>Spencer Holtaway</span><span aria-hidden="true"><span data-roll-label>Recent work</span><span style="color:#E4007C">.</span></span></span></span><span data-wide data-crumb style="font-weight:500; color:#5E5E5E"></span></a>
        <nav data-wide style="display:flex; gap:clamp(14px,2.5vw,32px); font-size:15px; font-weight:500">
          <a href="#work" data-nav="Recent work" style="border-bottom:2px solid transparent; padding-bottom:2px">Recent work</a>
          <a href="#about" data-nav="About" style="border-bottom:2px solid transparent; padding-bottom:2px">About</a>
          <a href="#ethics" data-nav="Ethics" style="border-bottom:2px solid transparent; padding-bottom:2px">Ethics</a>
          <a href="#history" data-nav="History" style="border-bottom:2px solid transparent; padding-bottom:2px">History</a>
        </nav>
        <button type="button" data-narrow data-menu-btn aria-expanded="false" aria-controls="menu" style="all:unset; cursor:pointer; min-height:44px; padding:0 4px; display:flex; align-items:center; gap:8px; font-weight:600; font-family:'JetBrains Mono',monospace; font-size:15px"><span data-menu-label>Menu</span><span style="width:8px; height:8px; border-radius:50%; background:#E4007C"></span></button>
      </div>
    </header>
    <div id="menu" hidden style="position:fixed; inset:0; top:73px; z-index:9; background:#111; color:#FAFAF7; padding:32px clamp(20px,4vw,56px); display:grid; align-content:start; gap:4px">
      <a href="#work" data-close style="color:#FAFAF7; font-weight:700; font-size:clamp(44px,13vw,56px); line-height:1.05; letter-spacing:-0.05em">Recent work</a>
      <a href="#about" data-close style="color:#FAFAF7; font-weight:700; font-size:clamp(44px,13vw,56px); line-height:1.05; letter-spacing:-0.05em">About</a>
      <a href="#ethics" data-close style="color:#FAFAF7; font-weight:700; font-size:clamp(44px,13vw,56px); line-height:1.05; letter-spacing:-0.05em">Ethics</a>
      <a href="#history" data-close style="color:#FAFAF7; font-weight:700; font-size:clamp(44px,13vw,56px); line-height:1.05; letter-spacing:-0.05em">History</a>
      <a href="mailto:spencer@holtawaydesign.com" style="color:#BDBDB8; font-size:16px; margin-top:32px">spencer@holtawaydesign.com</a>
    </div>

    <main id="top" style="display:grid; align-content:center; gap:clamp(48px,8vw,96px); width:100%; max-width:1360px; margin:0 auto; padding:clamp(48px,10vw,140px) clamp(20px,4vw,56px)">
      <h1 data-h1="1" style="margin:0; font-weight:800; line-height:1.12; letter-spacing:-0.025em; max-width:none; text-wrap:balance"><span style="display:block">Spencer Holtaway<span style="color:#E4007C">,</span></span><span style="display:block">Staff Product Designer</span></h1>

      <section id="work" data-screen-label="Recent work" style="scroll-margin-top:73px; background:#0E0E0E; color:#FAFAF7; box-shadow:0 0 0 100vmax #0E0E0E; clip-path:inset(0 -100vmax); padding:clamp(56px,8vw,112px) 0; display:grid; gap:16px">
        <h2 style="margin:0 0 8px; color:#FAFAF7; font-weight:800; font-size:clamp(32px,4.4vw,60px); line-height:1.08; letter-spacing:-0.025em; text-wrap:balance">What I've been working on recently</h2>
        <p style="margin:0 0 16px; color:#C9C9C4; max-width:60ch; font-size:clamp(18px,1.6vw,21px); line-height:1.45; text-wrap:pretty">Five apps, designed and built end to end. With AI doing more of the building, I spend more of my time on the parts I care about: how it feels in your hand, what it does when you’re not looking, and whether it’s worth coming back to.</p>
        <div data-bento="1" style="border-top:1px solid #3A3A3A; padding-top:24px">
          <a href="/fishingforcompliments" data-tile="ffc" style="display:grid; grid-template-rows:auto 1fr; align-content:start; gap:12px; min-width:0; color:#FAFAF7">
            <div data-panel="1" style="position:relative; overflow:hidden; min-height:0; border-radius:14px; background:#3A2D4A">
              <Shot name="fishingforcompliments/isles" alt="Fishing for Compliments: Isles gameplay" widths={[480, 720, 960, 1280, 1600, 1920, 2400]} sizes="(max-width: 900px) 127vw, min(72vw, 980px)" style="position:absolute; inset:0; display:block; width:100%; height:100%; object-fit:cover; object-position:50% 60%; transform:scale(1.03)" />
            </div>
            <div style="display:grid; gap:2px">
              <span style="font-weight:700; font-size:clamp(20px,2vw,26px); line-height:1.1; letter-spacing:-0.03em">Fishing for Compliments</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:14px; color:#A8A8A3">A game with no finish line →</span>
            </div>
          </a>
          <a href="/breathebody" data-tile="bb" style="display:grid; grid-template-rows:auto 1fr; align-content:start; gap:12px; min-width:0; color:#FAFAF7">
            <div data-panel="1" style="position:relative; overflow:hidden; min-height:0; border-radius:14px; background:#0B0B10">
              <Shot name="breathebody/01" alt="Breath Body screen" widths={[240, 360, 480, 640, 900]} sizes="(max-width: 560px) 50vw, (max-width: 900px) 34vw, 440px" style="position:absolute; inset:0; display:block; width:100%; height:100%; object-fit:cover; object-position:50% 45%" />
            </div>
            <div style="display:grid; gap:2px">
              <span style="font-weight:700; font-size:clamp(20px,2vw,26px); line-height:1.1; letter-spacing:-0.03em">Breath Body</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:14px; color:#A8A8A3">A breathing app you don’t look at →</span>
            </div>
          </a>
          <a href="/mybussf" data-tile="mb" style="display:grid; grid-template-rows:auto 1fr; align-content:start; gap:12px; min-width:0; color:#FAFAF7">
            <div data-panel="1" style="position:relative; overflow:hidden; min-height:0; border-radius:14px; background:#FFB000">
              <Shot name="mybussf/map" alt="My Bus SF map screen" widths={[240, 360, 480, 640, 900]} sizes="(max-width: 560px) 50vw, (max-width: 900px) 34vw, 330px" style="position:absolute; inset:0; display:block; width:100%; height:100%; object-fit:cover; object-position:50% 100%" />
            </div>
            <div style="display:grid; gap:2px">
              <span style="font-weight:700; font-size:clamp(20px,2vw,26px); line-height:1.1; letter-spacing:-0.03em">My Bus SF</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:14px; color:#A8A8A3">Real-time Muni arrivals →</span>
            </div>
          </a>
          <a href="/olivers-train" data-tile="ot" style="display:grid; grid-template-rows:auto 1fr; align-content:start; gap:12px; min-width:0; color:#FAFAF7">
            <div data-panel="1" style="position:relative; overflow:hidden; min-height:0; border-radius:14px; background:#1F4D3A">
              <Shot name="olivers-train/01" alt="Oliver’s Train window view" widths={[480, 720, 960, 1280, 1600, 1920]} sizes="(max-width: 900px) 100vw, 680px" style="position:absolute; inset:0; display:block; width:100%; height:100%; object-fit:cover; object-position:50% 0%" />
            </div>
            <div style="display:grid; gap:2px">
              <span style="font-weight:700; font-size:clamp(20px,2vw,26px); line-height:1.1; letter-spacing:-0.03em">Oliver’s Train</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:14px; color:#A8A8A3">A game you can’t win, lose, or cheat →</span>
            </div>
          </a>
          <a href="/pingpongcowboy" data-tile="pp" style="display:grid; grid-template-rows:auto 1fr; align-content:start; gap:12px; min-width:0; color:#FAFAF7">
            <div data-panel="1" style="position:relative; overflow:hidden; min-height:0; border-radius:14px; background:#4A2C19">
              <Shot name="pingpongcowboy/01" alt="Ping Pong Cowboy screen" widths={[240, 360, 480, 640, 900, 1200]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 34vw, 330px" style="position:absolute; inset:0; display:block; width:100%; height:100%; object-fit:cover; object-position:50% 0%" />
            </div>
            <div style="display:grid; gap:2px">
              <span style="font-weight:700; font-size:clamp(20px,2vw,26px); line-height:1.1; letter-spacing:-0.03em">Ping Pong Cowboy</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:14px; color:#A8A8A3">Remember when phones were toys? →</span>
            </div>
          </a>
        </div>
      </section>

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr)); gap:48px clamp(32px,5vw,72px); align-items:start">
      <section id="about" data-screen-label="About" style="scroll-margin-top:96px; display:grid">
        <div style="display:grid; gap:16px; align-content:start">
          <span style="font-family:'JetBrains Mono',monospace; font-size:13px; letter-spacing:0.04em; text-transform:uppercase; color:#5E5E5E">About</span>
          <p style="margin:0; font-size:clamp(20px,2vw,26px); line-height:1.35; letter-spacing:-0.01em; text-wrap:pretty">Making things and hearing “thank you” at the end is what it’s all about for me.</p>
          <p style="margin:0; text-wrap:pretty">I started out designing real-world experiences, then games at Zynga, then a long stretch in SaaS as Head of Design at Dialpad and Staff Product Designer at Calm.</p>
          <p style="margin:0; text-wrap:pretty">Whether it's a phone system's admin settings, a carpool app for families or how someone feels when they open Calm, I take on the complexity so the person using it doesn't have to.</p>
          <p style="margin:0; font-family:'JetBrains Mono',monospace; font-size:13px; color:#5E5E5E; overflow:hidden"><span data-roleline><span>AI Native Staff Product Designer</span><span>San Rafael, CA</span></span></p>
        </div>
      </section>

      <section id="ethics" data-screen-label="Ethics" style="display:grid; gap:16px; align-content:start; scroll-margin-top:96px">
        <span style="font-family:'JetBrains Mono',monospace; font-size:13px; letter-spacing:0.04em; text-transform:uppercase; color:#5E5E5E">What I stand for</span>
        <ul style="margin:0; padding:0; list-style:none; display:grid; border-top:1px solid #111">
          <li style="padding:12px 0; border-bottom:1px solid #D6D6D1; font-weight:700; font-size:clamp(20px,2vw,24px); letter-spacing:-0.02em">Meet customers where they are.</li>
          <li style="padding:12px 0; border-bottom:1px solid #D6D6D1; font-weight:700; font-size:clamp(20px,2vw,24px); letter-spacing:-0.02em">Make it worth coming back to.</li>
          <li style="padding:12px 0; border-bottom:1px solid #D6D6D1; font-weight:700; font-size:clamp(20px,2vw,24px); letter-spacing:-0.02em">No dark patterns.</li>
        </ul>
      </section>
      </div>

      <section id="history" data-screen-label="Work history" style="scroll-margin-top:96px; display:grid; gap:16px">
        <span style="font-family:'JetBrains Mono',monospace; font-size:13px; letter-spacing:0.04em; text-transform:uppercase; color:#5E5E5E">Work history</span>
        <div style="display:grid; border-top:1px solid #111">
          {jobs.map((j) => (
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr)); gap:2px 24px; padding:14px 0; border-bottom:1px solid #D6D6D1; align-items:baseline">
              <span style="font-weight:700; font-size:clamp(18px,1.8vw,22px); letter-spacing:-0.02em">{j.co}</span>
              <span style="font-size:17px">{j.title}</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:14px; color:#A8A8A3">{j.dates}</span>
            </div>
          ))}
        </div>
      </section>
    </main>

    <footer style="width:calc(100% - 2 * clamp(20px,4vw,56px)); max-width:calc(1360px - 2 * clamp(20px,4vw,56px)); margin:0 auto; padding:24px 0 32px; border-top:1px solid #D6D6D1; display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; font-family:'JetBrains Mono',monospace; font-size:13px; color:#5E5E5E">
      <span>© 2026 Spencer Holtaway</span>
      <span style="display:flex; flex-wrap:wrap; gap:8px 24px"><a href="mailto:spencer@holtawaydesign.com" style="color:#5E5E5E">spencer@holtawaydesign.com</a><a href="https://linkedin.com/in/holtawaydesign" style="color:#5E5E5E">LinkedIn</a></span>
    </footer>
  </div>

  <script is:inline>
    (function () {
      var header = document.querySelector('header');
      var roll = document.querySelector('[data-roll]');
      var rollLabel = document.querySelector('[data-roll-label]');
      var crumb = document.querySelector('[data-crumb]');
      var navLinks = document.querySelectorAll('[data-nav]');
      var menu = document.getElementById('menu');
      var btn = document.querySelector('[data-menu-btn]');
      var btnLabel = document.querySelector('[data-menu-label]');
      var narrowMq = matchMedia('(max-width: 719px)');
      var reduceMq = matchMedia('(prefers-reduced-motion: reduce)');
      var sections = [['work', 'Recent work'], ['about', 'About'], ['ethics', 'Ethics'], ['history', 'History']];
      var current = '';
      var last = '';
      var open = false;

      function render() {
        var narrow = narrowMq.matches;
        if (!narrow && open) setMenu(false);
        roll.style.transform = narrow && current && !open ? 'translateY(-50%)' : 'none';
        rollLabel.textContent = current || last || 'Recent work';
        crumb.textContent = current ? '/ ' + current : '';
        navLinks.forEach(function (a) {
          a.style.borderBottomColor = a.getAttribute('data-nav') === current ? '#E4007C' : 'transparent';
        });
      }

      function onScroll() {
        var cur = '';
        var top = (header ? header.offsetHeight : 73) + 24;
        sections.forEach(function (s) {
          var el = document.getElementById(s[0]);
          if (el && el.getBoundingClientRect().top < top) cur = s[1];
        });
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) cur = 'History';
        if (cur) last = cur;
        if (cur !== current) {
          current = cur;
          render();
        }
      }

      function setMenu(next) {
        open = next;
        menu.hidden = !open;
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btnLabel.textContent = open ? 'Close' : 'Menu';
        render();
      }

      btn.addEventListener('click', function () { setMenu(!open); });
      document.querySelectorAll('[data-close]').forEach(function (a) {
        a.addEventListener('click', function () { setMenu(false); });
      });
      document.querySelector('[data-totop]').addEventListener('click', function (e) {
        e.preventDefault();
        setMenu(false);
        scrollTo({ top: 0, behavior: reduceMq.matches ? 'auto' : 'smooth' });
      });
      narrowMq.addEventListener('change', render);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      render();
    })();
  </script>
</Base>
