---
// "App page" and App Store buttons for one of the five apps. The App Store
// button turns into a real link once its URL is set in src/data/appstore.ts.
import { APP_STORE, type AppSlug } from '../../data/appstore';

interface Props {
  app: AppSlug;
}

const { app } = Astro.props;
const store = APP_STORE[app] as string | null;
---

<div class="btn-row">
  <a href={`/${app}`} class="btn btn--solid">App page →</a>
  {
    store ? (
      <a href={store} class="btn btn--outline">Download on the App Store</a>
    ) : (
      <span class="btn btn--pending" aria-disabled="true">App Store link, coming soon</span>
    )
  }
</div>
