---
// A top-level section: a heavy rule, a small label row, and (optionally) the
// section's name set huge and right-aligned.
interface Props {
  id: string;
  label: string;
  aside: string;
  /** The huge word, e.g. "Work". Gets an accent full stop. */
  word?: string;
  class?: string;
}

const { id, label, aside, word, class: className } = Astro.props;
---

<section id={id} class:list={['section', className]}>
  <div class="section__bar t-detail">
    <span>{label}</span>
    <span class="section__aside">{aside}</span>
  </div>
  {word && <div class="t-section section__word" aria-hidden="true">{word}<span class="t-accent">.</span></div>}
  <slot />
</section>
