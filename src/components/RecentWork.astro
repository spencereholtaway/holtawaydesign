---
// "What I've been working on recently": the dark band with the five apps in a
// bento. Shared by the holding page and the portfolio; styles in recent.css.
import Shot from './Shot.astro';
import { APPS } from '../data/apps';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<section id={id} class="recent">
  <h2 class="recent__title">What I've been working on recently</h2>
  <p class="recent__lede"><strong>5 iOS apps in 30 days.</strong> With AI as my engineering partner, I focused on the parts that matter most: how the mechanics support the ethical grounding and goals of each app, and the overall look, feel, polish of the user experience including performance, visual, audio and haptic design.</p>
  <div data-bento>
    <a href="/fishingforcompliments" data-tile="ffc" data-tilt>
      <div data-panel data-tilt-panel style="--tint:#3A2D4A">
        <Shot name="fishingforcompliments/isles" alt="Fishing for Compliments: Isles gameplay" widths={[480, 720, 960, 1280, 1600, 1920, 2400]} sizes="(max-width: 900px) 127vw, min(72vw, 980px)" style="object-position:50% 60%; transform:scale(1.03)" />
      </div>
      <div class="tile__text">
        <span class="tile__name">{APPS.fishingforcompliments.name}</span>
        <span class="tile__line">A mindfulness game with no finish line →</span>
      </div>
    </a>
    <a href="/breathebody" data-tile="bb" data-tilt>
      <div data-panel data-tilt-panel style="--tint:#0B0B10">
        <Shot name="breathebody/01" alt="Breath Body screen" widths={[240, 360, 480, 640, 900]} sizes="(max-width: 560px) 50vw, (max-width: 900px) 34vw, 440px" style="object-position:50% 45%" />
      </div>
      <div class="tile__text">
        <span class="tile__name">{APPS.breathebody.name}</span>
        <span class="tile__line">Breathwork for less than a cup of coffee →</span>
      </div>
    </a>
    <a href="/mybussf" data-tile="mb" data-tilt>
      <div data-panel data-tilt-panel style="--tint:#FFB000">
        <Shot name="mybussf/saved-stops" alt="My Bus SF Home Screen widgets" widths={[240, 360, 480, 640, 900]} sizes="(max-width: 560px) 50vw, (max-width: 900px) 34vw, 330px" style="object-position:50% 0%" />
      </div>
      <div class="tile__text">
        <span class="tile__name">{APPS.mybussf.name}</span>
        <span class="tile__line">Real-time Muni arrivals, just $0.99 →</span>
      </div>
    </a>
    <a href="/olivers-train" data-tile="ot" data-tilt>
      <div data-panel data-tilt-panel style="--tint:#1F4D3A">
        <Shot name="olivers-train/01" alt="Oliver’s Train window view" widths={[480, 720, 960, 1280, 1600, 1920]} sizes="(max-width: 900px) 100vw, 680px" style="object-position:50% 0%" />
      </div>
      <div class="tile__text">
        <span class="tile__name">{APPS['olivers-train'].name}</span>
        <span class="tile__line">A mindfulness experience you can’t win, lose, or cheat →</span>
      </div>
    </a>
    <a href="/pingpongcowboy" data-tile="pp" data-tilt>
      <div data-panel data-tilt-panel style="--tint:#4A2C19">
        <Shot name="pingpongcowboy/01" alt="Ping Pong Cowboy screen" widths={[240, 360, 480, 640, 900, 1200]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 34vw, 330px" style="object-position:50% 0%" />
      </div>
      <div class="tile__text">
        <span class="tile__name">{APPS.pingpongcowboy.name}</span>
        <span class="tile__line">Remember when phones were toys? →</span>
      </div>
    </a>
  </div>
  <script>
    import '../scripts/tilt';
  </script>
</section>
