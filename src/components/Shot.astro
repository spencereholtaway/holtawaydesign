---
// Responsive screenshot. `name` is a path under src/assets/apps or src/assets
// without the extension, e.g. "breathebody/01" or "work/pge/light". Astro resizes it to WebP at several widths
// so phones download a small file instead of the full-size PNG.
// If the source file hasn't been added yet, nothing renders and the panel's
// background colour shows through.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  widths: number[];
  sizes: string;
  style?: string;
  class?: string;
  eager?: boolean;
}

const { name, alt, widths, sizes, style, class: className, eager = false } = Astro.props;

const files = import.meta.glob<ImageMetadata>('../assets/**/*.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
});
const stem = (k: string) => k.replace(/\.[a-z]+$/, '');
const key =
  Object.keys(files).find((k) => stem(k) === `../assets/apps/${name}`) ??
  Object.keys(files).find((k) => stem(k) === `../assets/${name}`);
const src = key ? files[key] : undefined;

let img;
if (src) {
  img = await getImage({
    src,
    format: 'webp',
    quality: 80,
    widths: widths.filter((w) => w <= src.width),
    sizes,
  });
} else {
  console.warn(`[Shot] missing image src/assets/{apps/,}${name}.(png|jpg|webp)`);
}
---

{
  img && (
    <img
      src={img.src}
      srcset={img.srcSet.attribute}
      sizes={sizes}
      width={src!.width}
      height={src!.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      style={style}
      class={className}
    />
  )
}
