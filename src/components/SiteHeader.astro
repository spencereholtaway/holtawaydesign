---
// Sticky "Spencer Holtaway" bar for the app pages, themed per page.
// At the top of the page the name links to the homepage. Once a section marked
// with data-section has scrolled under the bar, the name rolls up to show that
// section's title, and clicking it scrolls back to the top instead.
interface Props {
  /** Inner row width, matching the page's container. */
  maxWidth: number;
  background: string;
  border: string;
  color: string;
  /** Colour of the full stop after the section title. */
  accent: string;
  /** Colour of the Support / Privacy links. */
  link: string;
  /** Font weight for the name, in the page's own UI font. */
  weight: number;
  /** Extra styles for the nav (font family, size). */
  navStyle?: string;
}

const { maxWidth, background, border, color, accent, link, weight, navStyle = '' } = Astro.props;
---

<header
  data-site-header
  style={`position:sticky; top:0; z-index:20; background:${background}; backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); border-bottom:1px solid ${border}; color:${color}`}
>
  <div
    style={`max-width:${maxWidth}px; margin:0 auto; padding:8px clamp(20px,4vw,48px); display:flex; justify-content:space-between; align-items:center; gap:16px; min-height:60px`}
  >
    <a
      href="/"
      data-site-name
      style={`color:${color}; text-decoration:none; font-weight:${weight}; font-size:16px; letter-spacing:-0.01em; display:flex; align-items:center; min-height:44px; white-space:nowrap; min-width:0; overflow-wrap:normal`}
    >
      <span style="display:block; height:1.3em; line-height:1.3; overflow:hidden">
        <span data-roll style="display:flex; flex-direction:column; transition:transform 460ms cubic-bezier(.2,.7,.2,1)">
          <span>Spencer Holtaway</span>
          <span aria-hidden="true"><span data-roll-label></span><span style={`color:${accent}`}>.</span></span>
        </span>
      </span>
    </a>
    <nav style={`display:flex; flex-shrink:0; gap:clamp(14px,4vw,20px); font-size:15px; font-weight:600; ${navStyle}`}>
      <a href="#support" style={`color:${link}; text-decoration:none; white-space:nowrap; overflow-wrap:normal`}>Support</a>
      <a href="#privacy" style={`color:${link}; text-decoration:none; white-space:nowrap; overflow-wrap:normal`}>Privacy</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('[data-site-header]');
    var name = header.querySelector('[data-site-name]');
    var roll = header.querySelector('[data-roll]');
    var label = header.querySelector('[data-roll-label]');
    var current = '';

    function update() {
      // Looked up on each call: this script runs before the sections below it exist.
      var sections = document.querySelectorAll('[data-section]');
      var line = header.offsetHeight + 24;
      var cur = '';
      sections.forEach(function (el) {
        if (el.getBoundingClientRect().top < line) cur = el.getAttribute('data-section');
      });
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4 && sections.length) {
        cur = sections[sections.length - 1].getAttribute('data-section');
      }
      if (cur === current) return;
      current = cur;
      if (cur) label.textContent = cur;
      roll.style.transform = cur ? 'translateY(-50%)' : 'none';
      name.setAttribute('aria-label', cur ? 'Back to top' : 'Spencer Holtaway, home');
    }

    name.addEventListener('click', function (e) {
      if (!current) return; // at the top: follow the link to the homepage
      e.preventDefault();
      scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', update);
    else update();
  })();
</script>
